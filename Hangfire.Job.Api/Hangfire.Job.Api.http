@Hangfire.Job.Api_HostAddress = http://localhost:5222

### Schedule a recurring job that POSTs to your callback URL
POST {{Hangfire.Job.Api_HostAddress}}/api/jobs
Content-Type: application/json

{
  "uniqueId": "order-42",
  "cron": "*/5 * * * *",
  "callbackUrl": "https://example.com/webhooks/hangfire",
  "metaData": {
    "orderId": "42"
  }
}

### Delete a recurring job
DELETE {{Hangfire.Job.Api_HostAddress}}/api/jobs/order-42

### Dashboard (401 unless Hangfire:Dashboard credentials are supplied)
GET {{Hangfire.Job.Api_HostAddress}}/dashboard
